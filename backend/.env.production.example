# ─── Threads Backend — PRODUCTION Environment Variables ──────────────────────
# Fill these in after setting up each service below.
# Set these as secrets in Fly.io — never commit this file.

NODE_ENV=production

# ─── Ports ────────────────────────────────────────────────────────────────────
PORT=4000
FETCH_PORT=5002

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Your existing Atlas URI — add the database name before the ?
MONGO_URI=mongodb+srv://kanav:YOUR_PASSWORD@cluster0.fxgpn.mongodb.net/scalable-chat?appName=Cluster0

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# From upstash.com → your database → "Redis Connect" → copy the rediss:// URL
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379

# ─── Redpanda Cloud (Kafka) ───────────────────────────────────────────────────
# From cloud.redpanda.com → your cluster → "Connect" tab
KAFKA_BROKERS=YOUR_CLUSTER.redpanda.com:9092
KAFKA_USERNAME=YOUR_REDPANDA_USERNAME
KAFKA_PASSWORD=YOUR_REDPANDA_PASSWORD

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL — set AFTER deploying frontend
CLIENT_ORIGIN=https://YOUR_APP.vercel.app
