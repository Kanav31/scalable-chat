# ─── Threads Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development         # "development" | "production"

# ─── Ports ────────────────────────────────────────────────────────────────────
PORT=4000                    # socketservice.js (port 5000 is reserved by macOS AirPlay)
FETCH_PORT=5002              # fetchService.js (5001 is kept free as a buffer)

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local (Docker):     mongodb://localhost:27017/threads
# Production (Atlas): mongodb+srv://<user>:<pass>@cluster.mongodb.net/threads
MONGO_URI=mongodb://localhost:27017/threads

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local (Docker):     redis://localhost:6379
# Production (Upstash): rediss://<user>:<pass>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Local (Docker):   localhost:9092  — no auth needed
# Production (Redpanda Cloud): your-cluster.redpanda.com:9092 — needs USERNAME + PASSWORD
KAFKA_BROKERS=localhost:9092

# Only required in production (NODE_ENV=production):
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lock this down to your frontend URL in production
# Local: * (allow all)
# Production: https://your-frontend.vercel.app
CLIENT_ORIGIN=*
